---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import Stats from "../components/Stats.astro";
import Results from "../components/Results.astro";
import Pareto from "../components/Pareto.astro";
import Features from "../components/Features.astro";
import ApiPreview from "../components/ApiPreview.astro";
import Architecture from "../components/Architecture.astro";
import Audiences from "../components/Audiences.astro";
import Methodology from "../components/Methodology.astro";
import FinalCta from "../components/FinalCta.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="trivium — The reproducible benchmark for hybrid search"
  description="A reproducible benchmark for hybrid search engines — BM25, dense vector, RRF fusion, and cross-encoder rerank — on distractor-augmented BEIR scifact. Defensible numbers, open methodology."
  pageClass="page-home"
>
  <SiteHeader />
  <main id="content">
    <Hero />
    <TrustBar />
    <Stats />
    <Results />
    <Pareto />
    <Features />
    <ApiPreview />
    <Architecture />
    <Audiences />
    <Methodology />
    <FinalCta />
  </main>
  <SiteFooter />
</BaseLayout>