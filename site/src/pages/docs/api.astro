        <tbody>
          <tr><td><code>trivium-prepare</code></td><td>Build the corpus, query, qrels, and embedding caches.</td></tr>
          <tr><td><code>trivium-benchmark</code></td><td>Run registered pipeline modes across one or more scales.</td></tr>
          <tr><td><code>trivium-summarise</code></td><td>Print a concise summary from a benchmark CSV.</td></tr>
          <tr><td><code>trivium-gigatoken-bench</code></td><td>Measure tokenizer throughput for a local corpus stream.</td></tr>
        </tbody>
      </table>
    </div>
  </section>
