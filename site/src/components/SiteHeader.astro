---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props as Props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "") || "";
const homeUrl = baseUrl ? `${baseUrl}/` : "/";
---

<header class:list={["site-header", className]} data-scroll-progress>
  <div class="container-page site-header-inner">
    <a href={homeUrl} class="site-brand" aria-label="trivium home">
      <span class="site-brand-mark" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="brandGrad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="rgb(67 56 202)" />
              <stop offset="0.5" stop-color="rgb(99 102 241)" />
              <stop offset="1" stop-color="rgb(234 88 12)" />
            </linearGradient>
          </defs>
          <rect x="2" y="2" width="28" height="28" rx="8" fill="url(#brandGrad)" />
          <path
            d="M9 22V10h3v9h6v3H9zm11-12h3v12h-3V10zm-1 4.5l3.5-4.5h-3.5l-3.5 4.5 3.5 4.5h3.5L19 14.5z"
            fill="white"
          />
        </svg>
      </span>
      <span class="site-brand-name">trivium</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav-list">
        <li><a href="#features">Features</a></li>
        <li><a href="#results">Results</a></li>
        <li><a href="#methodology">Methodology</a></li>
        <li><a href="#architecture">Architecture</a></li>
      </ul>
    </nav>

    <div class="site-nav-actions">
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle color theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <a class="btn btn-secondary btn-sm" href="https://github.com/sachncs/trivium" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.57.11.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.94 10.94 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.07.78 2.16 0 1.56-.02 2.82-.02 3.2 0 .31.21.67.79.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
        </svg>
        <span>Star</span>
      </a>
      <a class="btn btn-primary btn-sm" href="https://github.com/sachncs/trivium#installation" rel="noopener">
        <span>Get started</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M9 7h8v8" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-scroll-progress]");
  if (header) {
    const onScroll = () => {
      const y = window.scrollY;
      if (y > 24) header.classList.add("is-scrolled");
      else header.classList.remove("is-scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background-color 0.3s var(--ease-smooth), border-color 0.3s var(--ease-smooth), backdrop-filter 0.3s var(--ease-smooth);
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background-color: rgb(var(--c-surface) / 0.78);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom-color: rgb(var(--c-border-subtle));
  }
  [data-theme="dark"] .site-header.is-scrolled {
    background-color: rgb(var(--c-surface-sunken) / 0.78);
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-height);
  }
  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 1.0625rem;
    color: rgb(var(--c-text));
  }
  .site-brand-mark {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.08), 0 4px 12px rgb(15 23 42 / 0.08);
  }
  .site-brand-name {
    line-height: 1;
  }
  .site-nav-list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav-list a {
    color: rgb(var(--c-text-mute));
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 0.2s var(--ease-smooth);
    position: relative;
  }
  .site-nav-list a:hover {
    color: rgb(var(--c-text));
  }
  .site-nav-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    border: 1px solid rgb(var(--c-border));
    background: rgb(var(--c-surface));
    color: rgb(var(--c-text-soft));
    cursor: pointer;
    transition: all 0.2s var(--ease-smooth);
  }
  [data-theme="dark"] .theme-toggle {
    background: rgb(var(--c-surface-raised));
  }
  .theme-toggle:hover {
    color: rgb(var(--c-text));
    border-color: rgb(var(--c-border-strong));
  }
  .theme-toggle .icon-moon {
    display: none;
  }
  [data-theme="dark"] .theme-toggle .icon-sun {
    display: none;
  }
  [data-theme="dark"] .theme-toggle .icon-moon {
    display: block;
  }
  @media (max-width: 820px) {
    .site-nav-list {
      display: none;
    }
    .site-nav-actions .btn-secondary span {
      display: none;
    }
  }
</style>