---
---

<section id="cta" class="cta-section section" aria-labelledby="cta-title">
  <div class="container-page">
    <div class="cta-card" data-reveal>
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-grid-overlay" aria-hidden="true"></div>

      <div class="cta-inner">
        <span class="eyebrow eyebrow-light">Get started</span>
        <h2 id="cta-title" class="heading-display cta-title">
          Reproducible in five commands.
          <br />
          Defensible by construction.
        </h2>
        <p class="cta-subhead">
          Install trivium, prepare the BEIR corpus, run the benchmark, summarise
          the rows, and read the README. Total time on a laptop: about five minutes.
        </p>

        <div class="cta-actions">
          <div class="cta-install">
            <span class="install-prompt" aria-hidden="true">$</span>
            <code class="install-cmd">pip install trivium</code>
            <button type="button" class="install-copy" data-copy="pip install trivium" aria-label="Copy install command">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" />
                <path d="M5 15V5a2 2 0 0 1 2-2h10" />
              </svg>
              <span class="install-copy-label">Copy</span>
            </button>
          </div>
          <a class="btn btn-light btn-lg" href="https://github.com/sachncs/trivium" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.57.11.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.94 10.94 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.07.78 2.16 0 1.56-.02 2.82-.02 3.2 0 .31.21.67.79.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
            </svg>
            <span>Star on GitHub</span>
          </a>
        </div>

        <ul class="cta-steps">
          <li><span class="step-bullet">01</span><span>pip install trivium</span></li>
          <li><span class="step-bullet">02</span><span>trivium-prepare --max-scales 100000</span></li>
          <li><span class="step-bullet">03</span><span>trivium-benchmark --modes bm25,vector,hybrid_rrf,hybrid_rerank</span></li>
          <li><span class="step-bullet">04</span><span>trivium-summarise --csv results/benchmark.csv</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-card {
    position: relative;
    isolation: isolate;
    padding: clamp(3rem, 6vw, 5rem);
    background: rgb(var(--c-ink-950));
    color: rgb(var(--c-ink-50));
    border-radius: 2rem;
    overflow: hidden;
  }
  .cta-glow {
    position: absolute;
    inset: -30%;
    z-index: -2;
    background:
      radial-gradient(ellipse 50% 40% at 25% 30%, rgb(var(--c-brand-700) / 0.4), transparent 70%),
      radial-gradient(ellipse 50% 40% at 75% 70%, rgb(var(--c-accent-700) / 0.35), transparent 70%);
  }
  .cta-grid-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 80%);
  }
  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .eyebrow-light {
    color: rgb(var(--c-ink-300));
  }
  .eyebrow-light::before {
    background: rgb(var(--c-brand-400));
    box-shadow: 0 0 0 4px rgb(var(--c-brand-900));
  }
  .cta-title {
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-block: 1.25rem 1.25rem;
    color: white;
    text-wrap: balance;
  }
  .cta-subhead {
    font-size: 1.0625rem;
    color: rgb(var(--c-ink-300));
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 560px;
    margin-inline: auto;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  .cta-install {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.55rem 0.55rem 0.95rem;
    background: rgb(var(--c-ink-50) / 0.06);
    border: 1px solid rgb(var(--c-ink-50) / 0.16);
    border-radius: 9999px;
    backdrop-filter: blur(8px);
  }
  .cta-install .install-prompt {
    color: rgb(var(--c-accent-400));
  }
  .cta-install .install-cmd {
    color: white;
  }
  .btn-light {
    background: white;
    color: rgb(var(--c-ink-900));
    border-color: white;
  }
  .btn-light:hover {
    background: rgb(var(--c-ink-100));
  }
  .cta-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    text-align: left;
  }
  @media (max-width: 640px) {
    .cta-steps {
      grid-template-columns: 1fr;
    }
  }
  .cta-steps li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    background: rgb(var(--c-ink-50) / 0.04);
    border: 1px solid rgb(var(--c-ink-50) / 0.08);
    border-radius: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: rgb(var(--c-ink-200));
  }
  .step-bullet {
    font-family: var(--font-mono);
    font-weight: 600;
    color: rgb(var(--c-brand-300));
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
</style>