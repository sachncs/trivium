---
import { scaleResults } from "../lib/results";

interface LabelOffset {
  dx: number;
  dy: number;
  anchor: "start" | "end";
}

interface ChartPoint {
  key: string;
  label: string;
  scale: string;
  latency: number;
  recall: number;
  winner: boolean;
  color: "brand" | "accent" | "ink";
  dx: number;
  dy: number;
  anchor: "start" | "end";
}

const width = 760;
const height = 390;
const padding = { top: 28, right: 34, bottom: 58, left: 70 };
const plotWidth = width - padding.left - padding.right;
const plotHeight = height - padding.top - padding.bottom;

const latencyMin = 0.03;
const latencyMax = 250;
const recallMin = 0.15;
const recallMax = 0.9;

const xPosition = (latency: number) => {
  const minimum = Math.log10(latencyMin);
  const maximum = Math.log10(latencyMax);
  return padding.left + ((Math.log10(Math.max(latency, latencyMin)) - minimum) / (maximum - minimum)) * plotWidth;
};

const yPosition = (recall: number) => padding.top + (1 - (recall - recallMin) / (recallMax - recallMin)) * plotHeight;

const labelOffsets: Record<string, LabelOffset> = {
  "5K-vector (flat)": { dx: 12, dy: -12, anchor: "start" },
  "5K-bm25": { dx: 12, dy: 20, anchor: "start" },
  "5K-hybrid_rrf": { dx: 16, dy: -14, anchor: "start" },
  "5K-hybrid_rerank": { dx: -12, dy: 20, anchor: "end" },
  "100K-vector (IVFPQ+RFlat)": { dx: 12, dy: -12, anchor: "start" },
  "100K-bm25": { dx: 12, dy: -14, anchor: "start" },
  "100K-hybrid_rrf": { dx: 16, dy: 20, anchor: "start" },
  "100K-hybrid_rerank": { dx: -12, dy: -14, anchor: "end" },
};

const displayLabel = (mode: string) => (mode === "vector (IVFPQ+RFlat)" ? "vector (IVFPQ)" : mode);
const colorFor = (mode: string): ChartPoint["color"] => {
  if (mode === "hybrid_rrf") return "brand";
  if (mode === "hybrid_rerank") return "accent";
  return "ink";
};

const points: ChartPoint[] = scaleResults.map((result) => {
  const key = `${result.scale}-${result.mode}`;
  const offset = labelOffsets[key];
  return {
    key,
    label: displayLabel(result.mode),
    scale: result.scale,
    latency: Number(result.latency),
    recall: Number(result.recall),
    winner: Boolean(result.winner),
    color: colorFor(result.mode),
    ...offset,
  };
});

const frontierPoints = (scale: string) =>
  points
    .filter((point) => point.scale === scale)
    .filter((point) =>
      points.every(
        (other) =>
          other.key === point.key ||
          other.scale !== scale ||
          other.latency > point.latency ||
          other.recall < point.recall,
      ),
    )
    .sort((left, right) => left.latency - right.latency);

const frontierPath = (scale: string) =>
  frontierPoints(scale)
    .map((point, index) => `${index === 0 ? "M" : "L"} ${xPosition(point.latency)} ${yPosition(point.recall)}`)
    .join(" ");

const yTicks = [0.2, 0.4, 0.6, 0.8].map((value) => ({ value, y: yPosition(value) }));
const xTicks = [0.1, 1, 10, 100].map((value) => ({ value, x: xPosition(value) }));
---

<figure class="pareto" aria-labelledby="pareto-title pareto-caption">
  <div class="pareto-head">
    <h2 id="pareto-title" class="pareto-title">Pareto frontier</h2>
    <span class="pareto-sub">Recall@10 vs p95 latency · log scale</span>
  </div>

  <div class="pareto-plot" role="img" aria-label="Scatter plot of recall at 10 against p95 latency for 5K and 100K benchmark runs">
    <svg viewBox={`0 0 ${width} ${height}`} class="pareto-svg" focusable="false">
      <title>Recall at 10 versus p95 latency</title>
      <desc>Each point is a measured benchmark result. Lower latency is better on the horizontal log scale and higher recall is better vertically. Lines connect the non-dominated points at each corpus scale.</desc>

      {yTicks.map((tick) => (
        <g class="axis-row">
          <line x1={padding.left} y1={tick.y} x2={width - padding.right} y2={tick.y} class="grid-line" />
          <text x={padding.left - 12} y={tick.y + 4} class="axis-label" text-anchor="end">{tick.value.toFixed(1)}</text>
        </g>
      ))}

      {xTicks.map((tick) => (
        <g class="axis-column">
          <line x1={tick.x} y1={padding.top} x2={tick.x} y2={height - padding.bottom} class="grid-line vertical-grid" />
          <line x1={tick.x} y1={height - padding.bottom} x2={tick.x} y2={height - padding.bottom + 5} class="tick" />
          <text x={tick.x} y={height - padding.bottom + 22} class="axis-label" text-anchor="middle">{tick.value} ms</text>
        </g>
      ))}

      <line x1={padding.left} y1={height - padding.bottom} x2={width - padding.right} y2={height - padding.bottom} class="axis-line" />
      <text x={width / 2} y={height - 10} class="axis-title" text-anchor="middle">p95 latency (milliseconds · logarithmic)</text>
      <text x={18} y={height / 2} class="axis-title" transform={`rotate(-90 18 ${height / 2})`} text-anchor="middle">Recall@10</text>

      {(["5K", "100K"] as const).map((scale) => (
        <path d={frontierPath(scale)} class={`frontier-line frontier-${scale.toLowerCase()}`} aria-label={`${scale} non-dominated frontier`} />
      ))}

      {points.map((point) => {
        const x = xPosition(point.latency);
        const y = yPosition(point.recall);
        return (
          <g class={`point point-${point.color} ${point.winner ? "is-winner" : ""}`} transform={`translate(${x} ${y})`} tabindex="0" aria-label={`${point.scale} ${point.label}: recall ${point.recall.toFixed(4)}, p95 latency ${point.latency} milliseconds`}>
            <title>{point.scale} · {point.label}: recall@10 {point.recall.toFixed(4)}, p95 {point.latency} ms</title>
            {point.winner && <line x1="0" y1="0" x2={point.dx * 0.72} y2={point.dy * 0.72} class="label-leader" />}
            {point.winner && <circle r="13" class="winner-glow" />}
            {point.winner && <circle r="9" class="winner-ring" />}
            <circle r={point.winner ? 6 : 4.5} class="dot" />
            {point.winner && <text x={point.dx} y={point.dy} class="point-label" text-anchor={point.anchor}>{point.label} · {point.scale}</text>}
          </g>
        );
      })}
    </svg>
  </div>

  <figcaption id="pareto-caption" class="pareto-caption">
    Lines connect measured points that are not dominated by another result at the same corpus scale. Hover or focus a point for its exact recall and latency.
  </figcaption>

  <ul class="pareto-legend" aria-label="Legend">
    <li><span class="legend-line legend-line-5k"></span> 5K frontier</li>
    <li><span class="legend-line legend-line-100k"></span> 100K frontier</li>
    <li><span class="legend-dot legend-dot-brand"></span> hybrid_rrf</li>
    <li><span class="legend-dot legend-dot-accent"></span> hybrid_rerank</li>
    <li><span class="legend-dot legend-dot-ink"></span> bm25 / vector</li>
  </ul>
</figure>

<style>
  .pareto {
    margin-top: 2.5rem;
    padding: 1.75rem;
    background: rgb(var(--c-surface));
    border: 1px solid rgb(var(--c-border));
    border-radius: 1.5rem;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04), 0 8px 24px rgb(15 23 42 / 0.04);
  }
  [data-theme="dark"] .pareto {
    background: rgb(var(--c-surface-raised));
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.4), 0 8px 24px rgb(0 0 0 / 0.3);
  }
  .pareto-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pareto-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    color: rgb(var(--c-text));
  }
  .pareto-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgb(var(--c-text-mute));
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .pareto-plot {
    overflow: hidden;
    padding: 0.75rem 0.5rem 0.25rem;
    border: 1px solid rgb(var(--c-border-subtle));
    border-radius: 1rem;
    background: linear-gradient(180deg, rgb(var(--c-surface-sunken) / 0.7), transparent 72%);
  }
  .pareto-svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .pareto-svg :global(.grid-line) {
    stroke: rgb(var(--c-border-subtle));
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .pareto-svg :global(.axis-line),
  .pareto-svg :global(.tick) {
    stroke: rgb(var(--c-border-strong));
    stroke-width: 1;
  }
  .pareto-svg :global(.axis-label) {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: rgb(var(--c-text-mute));
  }
  .pareto-svg :global(.axis-title) {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: rgb(var(--c-text-mute));
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .pareto-svg :global(.frontier-line) {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.72;
  }
  .pareto-svg :global(.frontier-5k) { stroke: rgb(var(--c-brand-500)); }
  .pareto-svg :global(.frontier-100k) { stroke: rgb(var(--c-accent-500)); }
  .pareto-svg :global(.label-leader) {
    stroke: rgb(var(--c-border-strong));
    stroke-width: 1;
    opacity: 0.7;
  }
  .pareto-svg :global(.dot) {
    fill: rgb(var(--c-text-soft));
    stroke: rgb(var(--c-surface));
    stroke-width: 2;
    transition: transform 0.2s var(--ease-smooth);
  }
  [data-theme="dark"] .pareto-svg :global(.dot) { stroke: rgb(var(--c-surface-raised)); }
  .pareto-svg :global(.point-brand .dot) { fill: rgb(var(--c-brand-600)); }
  [data-theme="dark"] .pareto-svg :global(.point-brand .dot) { fill: rgb(var(--c-brand-400)); }
  .pareto-svg :global(.point-accent .dot) { fill: rgb(var(--c-accent-600)); }
  [data-theme="dark"] .pareto-svg :global(.point-accent .dot) { fill: rgb(var(--c-accent-400)); }
  .pareto-svg :global(.point.is-winner .dot) {
    fill: white;
    stroke: rgb(var(--c-brand-600));
    stroke-width: 2.5;
  }
  [data-theme="dark"] .pareto-svg :global(.point.is-winner .dot) { stroke: rgb(var(--c-brand-400)); }
  .pareto-svg :global(.winner-ring) {
    fill: none;
    stroke: rgb(var(--c-brand-500));
    stroke-width: 1.5;
    stroke-dasharray: 2 3;
    opacity: 0.6;
  }
  .pareto-svg :global(.winner-glow) { fill: rgb(var(--c-brand-500) / 0.12); }
  .pareto-svg :global(.point-label) {
    font-family: var(--font-sans);
    font-size: 11px;
    fill: rgb(var(--c-text));
    font-weight: 500;
  }
  .pareto-svg :global(.point.is-winner .point-label) { font-weight: 700; }
  .pareto-svg :global(.point:hover .dot),
  .pareto-svg :global(.point:focus .dot) {
    transform: scale(1.35);
    transform-origin: center;
  }
  .pareto-svg :global(.point:focus) { outline: none; }
  .pareto-caption {
    margin: 0.75rem 0 0;
    font-size: 0.78rem;
    line-height: 1.55;
    color: rgb(var(--c-text-mute));
  }
  .pareto-legend {
    display: flex;
    gap: 1.15rem;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: rgb(var(--c-text-mute));
  }
  .pareto-legend li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .legend-dot { display: inline-block; width: 8px; height: 8px; border-radius: 9999px; }
  .legend-line { display: inline-block; width: 18px; height: 2px; border-radius: 99px; }
  .legend-line-5k { background: rgb(var(--c-brand-500)); }
  .legend-line-100k { background: rgb(var(--c-accent-500)); }
  .legend-dot-brand { background: rgb(var(--c-brand-600)); }
  [data-theme="dark"] .legend-dot-brand { background: rgb(var(--c-brand-400)); }
  .legend-dot-accent { background: rgb(var(--c-accent-600)); }
  [data-theme="dark"] .legend-dot-accent { background: rgb(var(--c-accent-400)); }
  .legend-dot-ink { background: rgb(var(--c-ink-400)); }
</style>
