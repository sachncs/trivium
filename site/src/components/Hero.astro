---
import { headlineResults } from "../lib/results.ts";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg bg-mesh" aria-hidden="true"></div>
  <div class="hero-grid-overlay" aria-hidden="true"></div>

  <div class="container-page hero-inner">
    <div class="hero-eyebrow-row" data-reveal>
      <span class="eyebrow">v0.1.0 · Apache-2.0 · Python 3.12+</span>
    </div>

    <h1 id="hero-title" class="hero-title heading-display" data-reveal data-reveal-delay="1">
      The reproducible benchmark
      <br class="hero-break" />
      for <span class="text-gradient">hybrid search</span>.
    </h1>

    <p class="hero-subhead" data-reveal data-reveal-delay="2">
      BM25, dense vector, RRF fusion, and cross-encoder rerank — measured honestly
      on distractor-augmented BEIR scifact. Defensible numbers. Open methodology.
      <span class="hero-subhead-em">One decorator away from your own pipeline.</span>
    </p>

    <div class="hero-actions" data-reveal data-reveal-delay="3">
      <div class="install-pill">
        <span class="install-prompt" aria-hidden="true">$</span>
        <code class="install-cmd">pip install trivium</code>
        <button type="button" class="install-copy" data-copy="pip install trivium" aria-label="Copy install command">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" />
            <path d="M5 15V5a2 2 0 0 1 2-2h10" />
          </svg>
          <span class="install-copy-label">Copy</span>
        </button>
      </div>
      <a class="btn btn-secondary btn-lg" href="https://github.com/sachncs/trivium" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.57.11.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.94 10.94 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.07.78 2.16 0 1.56-.02 2.82-.02 3.2 0 .31.21.67.79.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
        </svg>
        <span>Star on GitHub</span>
      </a>
    </div>

    <ul class="hero-meta" data-reveal data-reveal-delay="4">
      <li><strong>5 modes</strong><span>BM25 · vector · RRF · rerank · DiskBBQ</span></li>
      <li><strong>6 embedders</strong><span>MiniLM · BGE · mpnet · E5-Mistral</span></li>
      <li><strong>4 rerankers</strong><span>MiniLM CE · BGE · MonoT5</span></li>
      <li><strong>1 pre-flight</strong><span>0.6789 ± 0.03 vs Anserini</span></li>
    </ul>
  </div>

  <div class="container-page hero-showcase">
    <div class="hero-card" data-reveal data-reveal-delay="2" role="figure" aria-label="Headline benchmark results">
      <div class="hero-card-head">
        <div class="hero-card-tabs">
          <span class="dot dot-r"></span>
          <span class="dot dot-y"></span>
          <span class="dot dot-g"></span>
          <span class="hero-card-title">results/benchmark.csv</span>
        </div>
        <span class="hero-card-badge">5K scifact</span>
      </div>
      <div class="hero-card-body">
        <table class="hero-table">
          <thead>
            <tr>
              <th scope="col">Mode</th>
              <th scope="col" class="num">nDCG@10</th>
              <th scope="col" class="num">R@10</th>
              <th scope="col" class="num">p95 ms</th>
            </tr>
          </thead>
          <tbody>
            {headlineResults.map((row) => (
              <tr class={row.winner ? "is-winner" : ""}>
                <td class="mode">
                  {row.winner && (
                    <span class="winner-pip" aria-hidden="true">
                      <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                        <path d="M2 5l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  )}
                  <span>{row.mode}</span>
                </td>
                <td class="num">{row.ndcg}</td>
                <td class="num">{row.recall}</td>
                <td class="num">{row.latency}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="hero-card-foot">
          <div class="hero-bar">
            <span class="hero-bar-track">
              {headlineResults.map((row) => (
                <span class="hero-bar-seg" style={`flex: ${row.share}`} data-winner={row.winner ? "true" : null}></span>
              ))}
            </span>
            <span class="hero-bar-label">Quality share (nDCG@10)</span>
          </div>
          <p class="hero-card-note">
            Hybrid RRF <strong>+0.045 nDCG@10</strong> over BM25 at 5K — and
            <strong> +0.057</strong> over pure vector. Reproduce with
            <code>trivium-benchmark --modes bm25,vector,hybrid_rrf,hybrid_rerank --scales 5000</code>.
          </p>
        </div>
      </div>
    </div>

    <div class="hero-floats" aria-hidden="true">
      <div class="float-card float-card-a">
        <div class="float-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
        </div>
        <div class="float-body">
          <div class="float-title">Sub-millisecond</div>
          <div class="float-meta">Flat dense retrieval · p95 0.1 ms</div>
        </div>
      </div>
      <div class="float-card float-card-b">
        <div class="float-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 12l2 2 4-4" />
            <circle cx="12" cy="12" r="10" />
          </svg>
        </div>
        <div class="float-body">
          <div class="float-title">BM25 pre-flight</div>
          <div class="float-meta">0.6789 ± 0.03 — fails fast if it breaks</div>
        </div>
      </div>
      <div class="float-card float-card-c">
        <div class="float-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v18h18" />
            <path d="M7 14l4-4 4 4 5-5" />
          </svg>
        </div>
        <div class="float-body">
          <div class="float-title">Pareto frontier</div>
          <div class="float-meta">IVFPQ nprobe sweep · 6 grid points</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Copy install command
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest<HTMLButtonElement>("[data-copy]");
    if (!btn) return;
    const value = btn.getAttribute("data-copy") || "";
    navigator.clipboard.writeText(value).then(() => {
      const label = btn.querySelector<HTMLElement>(".install-copy-label");
      if (!label) return;
      const original = label.textContent;
      label.textContent = "Copied";
      btn.classList.add("is-copied");
      setTimeout(() => {
        label.textContent = original || "Copy";
        btn.classList.remove("is-copied");
      }, 1500);
    });
  });
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4.5rem, 8vw, 7rem) clamp(4rem, 7vw, 5.5rem);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: -10% -10% 0 -10%;
    z-index: -2;
    opacity: 1;
    pointer-events: none;
  }
  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgb(var(--c-ink-200) / 0.3) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(var(--c-ink-200) / 0.3) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 80%);
    opacity: 0.5;
  }
  [data-theme="dark"] .hero-grid-overlay {
    background-image:
      linear-gradient(to right, rgb(var(--c-ink-800) / 0.3) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(var(--c-ink-800) / 0.3) 1px, transparent 1px);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 880px;
    margin-inline: auto;
  }
  .hero-eyebrow-row {
    display: flex;
    justify-content: center;
    margin-bottom: 1.75rem;
  }
  .hero-title {
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
    margin-bottom: 1.5rem;
  }
  .hero-break {
    display: none;
  }
  @media (min-width: 768px) {
    .hero-break {
      display: inline;
    }
  }
  .hero-subhead {
    font-size: clamp(1.0625rem, 1.8vw, 1.1875rem);
    line-height: 1.55;
    color: rgb(var(--c-text-soft));
    max-width: 640px;
    margin: 0 auto 2.25rem;
    text-wrap: pretty;
  }
  .hero-subhead-em {
    display: block;
    margin-top: 0.5rem;
    color: rgb(var(--c-text));
    font-weight: 500;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }
  .install-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.55rem 0.55rem 0.95rem;
    background: rgb(var(--c-surface));
    border: 1px solid rgb(var(--c-border));
    border-radius: 9999px;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04), 0 6px 18px rgb(15 23 42 / 0.04);
    transition: border-color 0.2s var(--ease-smooth), box-shadow 0.2s var(--ease-smooth);
  }
  [data-theme="dark"] .install-pill {
    background: rgb(var(--c-surface-raised));
    border-color: rgb(var(--c-border));
  }
  .install-pill:hover {
    border-color: rgb(var(--c-border-strong));
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.06), 0 8px 22px rgb(15 23 42 / 0.06);
  }
  .install-prompt {
    font-family: var(--font-mono);
    color: rgb(var(--c-accent-600));
    font-weight: 500;
    font-size: 0.95rem;
    user-select: none;
  }
  .install-cmd {
    font-family: var(--font-mono);
    color: rgb(var(--c-text));
    font-size: 0.95rem;
    background: transparent;
    padding: 0;
    border: 0;
  }
  .install-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border-radius: 9999px;
    background: rgb(var(--c-ink-900));
    color: rgb(var(--c-ink-50));
    border: 0;
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 500;
    transition: all 0.2s var(--ease-smooth);
  }
  [data-theme="dark"] .install-copy {
    background: rgb(var(--c-ink-50));
    color: rgb(var(--c-ink-900));
  }
  .install-copy:hover {
    transform: translateY(-1px);
  }
  .install-copy.is-copied {
    background: rgb(var(--c-brand-600));
  }
  [data-theme="dark"] .install-copy.is-copied {
    background: rgb(var(--c-brand-400));
    color: rgb(var(--c-ink-950));
  }
  .install-copy-label {
    font-family: var(--font-sans);
  }
  .hero-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }
  @media (max-width: 720px) {
    .hero-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .hero-meta li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.1rem;
    border-radius: 1rem;
    border: 1px solid rgb(var(--c-border-subtle));
    background: rgb(var(--c-surface) / 0.6);
    backdrop-filter: blur(8px);
  }
  [data-theme="dark"] .hero-meta li {
    background: rgb(var(--c-surface) / 0.4);
    border-color: rgb(var(--c-border-subtle));
  }
  .hero-meta strong {
    font-family: var(--font-display);
    font-weight: 600;
    color: rgb(var(--c-text));
    font-size: 0.9375rem;
    letter-spacing: -0.015em;
  }
  .hero-meta span {
    font-size: 0.8125rem;
    color: rgb(var(--c-text-mute));
    line-height: 1.4;
  }

  /* Hero showcase */
  .hero-showcase {
    position: relative;
    margin-top: 4rem;
    z-index: 1;
  }
  .hero-card {
    max-width: 880px;
    margin: 0 auto;
    background: rgb(var(--c-surface));
    border: 1px solid rgb(var(--c-border));
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 0.04),
      0 16px 40px rgb(15 23 42 / 0.06),
      0 60px 120px -20px rgb(15 23 42 / 0.12);
  }
  [data-theme="dark"] .hero-card {
    background: rgb(var(--c-surface-raised));
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.4),
      0 16px 40px rgb(0 0 0 / 0.3),
      0 60px 120px -20px rgb(0 0 0 / 0.5);
  }
  .hero-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid rgb(var(--c-border-subtle));
    background: rgb(var(--c-surface-sunken));
  }
  [data-theme="dark"] .hero-card-head {
    background: rgb(var(--c-surface-sunken));
  }
  .hero-card-tabs {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
  }
  .dot-r {
    background: rgb(239 68 68);
  }
  .dot-y {
    background: rgb(234 179 8);
  }
  .dot-g {
    background: rgb(34 197 94);
  }
  .hero-card-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: rgb(var(--c-text-mute));
    margin-left: 0.4rem;
  }
  .hero-card-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.55rem;
    border-radius: 9999px;
    background: rgb(var(--c-brand-100));
    color: rgb(var(--c-brand-800));
  }
  [data-theme="dark"] .hero-card-badge {
    background: rgb(var(--c-brand-900));
    color: rgb(var(--c-brand-200));
  }
  .hero-card-body {
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .hero-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .hero-table th {
    text-align: left;
    font-weight: 500;
    color: rgb(var(--c-text-mute));
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid rgb(var(--c-border-subtle));
  }
  .hero-table th.num {
    text-align: right;
  }
  .hero-table td {
    padding: 0.85rem 0.75rem;
    color: rgb(var(--c-text));
    border-bottom: 1px solid rgb(var(--c-border-subtle));
  }
  .hero-table tr:last-child td {
    border-bottom: 0;
  }
  .hero-table td.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .hero-table td.mode {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero-table tr.is-winner td {
    background: linear-gradient(90deg, rgb(var(--c-brand-50) / 0.6), transparent);
    font-weight: 600;
  }
  [data-theme="dark"] .hero-table tr.is-winner td {
    background: linear-gradient(90deg, rgb(var(--c-brand-900) / 0.3), transparent);
  }
  .winner-pip {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 9999px;
    background: rgb(var(--c-brand-600));
    color: white;
    flex-shrink: 0;
  }
  [data-theme="dark"] .winner-pip {
    background: rgb(var(--c-brand-400));
    color: rgb(var(--c-ink-950));
  }
  .hero-card-foot {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--c-border-subtle));
  }
  .hero-bar {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 0.85rem;
  }
  .hero-bar-track {
    display: flex;
    height: 6px;
    border-radius: 9999px;
    overflow: hidden;
    background: rgb(var(--c-surface-inset));
  }
  [data-theme="dark"] .hero-bar-track {
    background: rgb(var(--c-surface-inset));
  }
  .hero-bar-seg {
    background: rgb(var(--c-ink-400));
  }
  .hero-bar-seg[data-winner] {
    background: linear-gradient(90deg, rgb(var(--c-brand-500)), rgb(var(--c-accent-500)));
  }
  .hero-bar-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(var(--c-text-mute));
  }
  .hero-card-note {
    font-size: 0.8125rem;
    color: rgb(var(--c-text-soft));
    line-height: 1.55;
  }
  .hero-card-note strong {
    color: rgb(var(--c-text));
    font-weight: 600;
  }
  .hero-card-note code {
    font-family: var(--font-mono);
    font-size: 0.78em;
    padding: 0.15em 0.4em;
    background: rgb(var(--c-surface-inset));
    border-radius: 4px;
  }

  /* Floating accent cards */
  .hero-floats {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .float-card {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 0.95rem;
    background: rgb(var(--c-surface));
    border: 1px solid rgb(var(--c-border));
    border-radius: 1rem;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 0.04),
      0 8px 24px rgb(15 23 42 / 0.08);
    pointer-events: auto;
  }
  [data-theme="dark"] .float-card {
    background: rgb(var(--c-surface-raised));
  }
  .float-card-a {
    top: 6%;
    left: -1rem;
    animation: drift 14s ease-in-out infinite;
  }
  .float-card-b {
    top: 38%;
    right: -2rem;
    animation: drift 16s ease-in-out infinite reverse;
  }
  .float-card-c {
    bottom: 8%;
    left: 8%;
    animation: drift 18s ease-in-out infinite;
  }
  @media (max-width: 1100px) {
    .float-card-a,
    .float-card-b,
    .float-card-c {
      display: none;
    }
  }
  .float-icon {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgb(var(--c-brand-100));
    color: rgb(var(--c-brand-700));
    flex-shrink: 0;
  }
  [data-theme="dark"] .float-icon {
    background: rgb(var(--c-brand-900));
    color: rgb(var(--c-brand-300));
  }
  .float-card-b .float-icon {
    background: rgb(var(--c-accent-100));
    color: rgb(var(--c-accent-700));
  }
  [data-theme="dark"] .float-card-b .float-icon {
    background: rgb(var(--c-accent-900));
    color: rgb(var(--c-accent-300));
  }
  .float-card-c .float-icon {
    background: rgb(var(--c-ink-100));
    color: rgb(var(--c-ink-700));
  }
  [data-theme="dark"] .float-card-c .float-icon {
    background: rgb(var(--c-ink-800));
    color: rgb(var(--c-ink-300));
  }
  .float-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgb(var(--c-text));
    line-height: 1.2;
  }
  .float-meta {
    font-size: 0.75rem;
    color: rgb(var(--c-text-mute));
    line-height: 1.3;
  }
</style>