---
import { stats } from "../lib/results.ts";
---

<section class="stats section-tight" aria-labelledby="stats-title">
  <div class="container-page">
    <div class="stats-grid" data-reveal>
      {stats.map((s, i) => (
        <div class="stat-card" data-reveal-delay={(i + 1).toString()}>
          <div class="stat-value">{s.value}</div>
          <div class="stat-label">{s.label}</div>
          <div class="stat-detail">{s.detail}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats {
    background: rgb(var(--c-surface-sunken) / 0.4);
  }
  [data-theme="dark"] .stats {
    background: rgb(var(--c-surface-sunken) / 0.5);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: rgb(var(--c-border-subtle));
    border: 1px solid rgb(var(--c-border-subtle));
    border-radius: 1.25rem;
    overflow: hidden;
  }
  @media (max-width: 820px) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .stat-card {
    padding: 2rem 1.75rem;
    background: rgb(var(--c-surface));
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: background-color 0.3s var(--ease-smooth);
  }
  [data-theme="dark"] .stat-card {
    background: rgb(var(--c-surface-raised));
  }
  .stat-card:hover {
    background: rgb(var(--c-surface-sunken));
  }
  .stat-value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: rgb(var(--c-text));
    background: linear-gradient(180deg, rgb(var(--c-text)) 0%, rgb(var(--c-text-mute)) 140%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .stat-label {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgb(var(--c-text));
    letter-spacing: -0.01em;
    margin-top: 0.5rem;
  }
  .stat-detail {
    font-size: 0.8125rem;
    color: rgb(var(--c-text-mute));
    line-height: 1.5;
  }
</style>