---
import { libraries } from "../lib/results.ts";
---

<section class="trust-bar" aria-label="Powered by">
  <div class="container-page trust-inner">
    <p class="trust-label">Built on the shoulders of</p>
    <div class="trust-marquee" aria-hidden="false">
      <div class="trust-track">
        {[...libraries, ...libraries].map((lib) => (
          <span class="trust-item">{lib.name}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .trust-bar {
    padding-block: 2.5rem;
    border-block: 1px solid rgb(var(--c-border-subtle));
    background: rgb(var(--c-surface-sunken) / 0.4);
  }
  [data-theme="dark"] .trust-bar {
    background: rgb(var(--c-surface-sunken) / 0.5);
  }
  .trust-inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    overflow: hidden;
  }
  .trust-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--c-text-mute));
    margin: 0;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .trust-marquee {
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }
  .trust-track {
    display: inline-flex;
    align-items: center;
    gap: 3.5rem;
    animation: marquee 35s linear infinite;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .trust-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
  .trust-item {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: rgb(var(--c-text-mute));
    transition: color 0.2s var(--ease-smooth);
  }
  .trust-item:hover {
    color: rgb(var(--c-text));
  }
</style>