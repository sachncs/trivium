---
const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "") || "";
const homeUrl = baseUrl ? `${baseUrl}/` : "/";

const cols = [
  {
    title: "Project",
    links: [
      { label: "GitHub", href: "https://github.com/sachncs/trivium" },
      { label: "README", href: "https://github.com/sachncs/trivium/blob/main/README.md" },
      { label: "Changelog", href: "https://github.com/sachncs/trivium/blob/main/CHANGELOG.md" },
      { label: "License (Apache-2.0)", href: "https://github.com/sachncs/trivium/blob/main/LICENSE" },
    ],
  },
  {
    title: "Reference",
    links: [
      { label: "Architecture", href: "https://github.com/sachncs/trivium#headline-results" },
      { label: "Methodology", href: "https://github.com/sachncs/trivium#methodology" },
      { label: "Pipeline registry", href: "https://github.com/sachncs/trivium#what-you-can-build" },
      { label: "Config schema", href: "https://github.com/sachncs/trivium" },
    ],
  },
  {
    title: "Community",
    links: [
      { label: "Issues", href: "https://github.com/sachncs/trivium/issues" },
      { label: "Discussions", href: "https://github.com/sachncs/trivium/discussions" },
      { label: "Contributing", href: "https://github.com/sachncs/trivium/blob/main/CONTRIBUTING.md" },
      { label: "Code of conduct", href: "https://github.com/sachncs/trivium" },
    ],
  },
];
---

<footer class="site-footer" role="contentinfo">
  <div class="container-page site-footer-inner">
    <div class="site-footer-brand">
      <a href={homeUrl} class="site-brand" aria-label="trivium home">
        <span class="site-brand-mark" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
            <defs>
              <linearGradient id="footerGrad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="rgb(99 102 241)" />
                <stop offset="0.5" stop-color="rgb(129 140 248)" />
                <stop offset="1" stop-color="rgb(234 88 12)" />
              </linearGradient>
            </defs>
            <rect x="2" y="2" width="28" height="28" rx="8" fill="url(#footerGrad)" />
            <path d="M9 22V10h3v9h6v3H9zm11-12h3v12h-3V10z" fill="white" />
          </svg>
        </span>
        <span class="site-brand-name">trivium</span>
      </a>
      <p class="site-footer-tagline">
        The reproducible benchmark for hybrid search engines. Apache-2.0.
      </p>
      <div class="site-footer-meta">
        <span>v0.1.0</span>
        <span class="dot-sep">·</span>
        <span>Python 3.12+</span>
        <span class="dot-sep">·</span>
        <span>101 tests passing</span>
      </div>
    </div>

    <nav class="site-footer-nav" aria-label="Footer">
      {cols.map((col) => (
        <div class="site-footer-col">
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href} rel="noopener">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="site-footer-bottom">
    <div class="container-page">
      <p>
        Released under the Apache-2.0 license. Built with
        <a href="https://astro.build" rel="noopener">Astro</a>.
        © {year} Sachin.
      </p>
      <p>
        A reproducible hybrid search benchmark for retrieval engineers, ML
        researchers, and OSS maintainers.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgb(var(--c-border-subtle));
    background: rgb(var(--c-surface-sunken) / 0.4);
  }
  [data-theme="dark"] .site-footer {
    background: rgb(var(--c-surface-sunken) / 0.5);
  }
  .site-footer-inner {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 3rem;
    padding-block: 3.5rem;
  }
  @media (max-width: 820px) {
    .site-footer-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  .site-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .site-footer-tagline {
    font-size: 0.9375rem;
    color: rgb(var(--c-text-soft));
    line-height: 1.55;
    max-width: 320px;
  }
  .site-footer-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgb(var(--c-text-mute));
  }
  .dot-sep {
    color: rgb(var(--c-text-faint));
  }
  .site-footer-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  @media (max-width: 540px) {
    .site-footer-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .site-footer-col h3 {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgb(var(--c-text-mute));
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .site-footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .site-footer-col a {
    font-size: 0.875rem;
    color: rgb(var(--c-text-soft));
    transition: color 0.2s var(--ease-smooth);
  }
  .site-footer-col a:hover {
    color: rgb(var(--c-text));
  }
  .site-footer-bottom {
    border-top: 1px solid rgb(var(--c-border-subtle));
    padding-block: 1.5rem;
  }
  .site-footer-bottom .container-page {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .site-footer-bottom p {
    font-size: 0.8125rem;
    color: rgb(var(--c-text-mute));
    margin: 0;
  }
  .site-footer-bottom a {
    color: rgb(var(--c-text-soft));
    text-decoration: underline;
    text-decoration-color: rgb(var(--c-text-faint));
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s var(--ease-smooth);
  }
  .site-footer-bottom a:hover {
    text-decoration-color: currentColor;
  }
</style>