---
const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "") || "";
const homeUrl = baseUrl ? `${baseUrl}/` : "/";
const docsUrl = `${baseUrl}/docs/`;

const cols = [
  {
    title: "Project",
    links: [
      { label: "GitHub", href: "https://github.com/sachncs/trivium" },
      { label: "Releases", href: "https://github.com/sachncs/trivium/releases" },
      { label: "License (Apache-2.0)", href: "https://github.com/sachncs/trivium/blob/main/LICENSE" },
    ],
  },
  {
    title: "Reference",
    links: [
      { label: "Documentation", href: docsUrl },
      { label: "Architecture", href: `${docsUrl}architecture/` },
      { label: "Methodology", href: `${docsUrl}methodology/` },
      { label: "API reference", href: `${docsUrl}api/` },
    ],
  },
  {
    title: "Community",
    links: [
      { label: "Issues", href: "https://github.com/sachncs/trivium/issues" },
      { label: "Discussions", href: "https://github.com/sachncs/trivium/discussions" },
      { label: "Contributing", href: `${docsUrl}contributing/` },
      { label: "Code of conduct", href: "https://github.com/sachncs/trivium" },
    ],
  },
];
---

<footer class="site-footer" role="contentinfo">
  <div class="container-page site-footer-inner">
    <div class="site-footer-brand">
      <a href={homeUrl} class="site-brand" aria-label="trivium home">
        <span class="site-brand-mark" aria-hidden="true">
          <svg width="44" height="44" viewBox="0 0 32 32" fill="none">
            <defs>
              <linearGradient id="footerMarkGradient" x1="4" y1="3" x2="28" y2="29" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="rgb(79 70 229)" />
                <stop offset="0.62" stop-color="rgb(99 102 241)" />
                <stop offset="1" stop-color="rgb(234 88 12)" />
              </linearGradient>
            </defs>
            <rect x="1.5" y="1.5" width="29" height="29" rx="9" fill="url(#footerMarkGradient)" />
            <path d="M8 8.5 16 16l8-3.5M8 16h16M8 23.5 16 16l8 3.5" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.92" />
            <circle cx="8" cy="8.5" r="2" fill="white" />
            <circle cx="8" cy="16" r="2" fill="white" />
            <circle cx="8" cy="23.5" r="2" fill="white" />
            <circle cx="16" cy="16" r="2.4" fill="white" />
            <circle cx="24" cy="12.5" r="2" fill="white" />
            <circle cx="24" cy="19.5" r="2" fill="white" />
          </svg>
        </span>
        <span class="site-brand-name">trivium</span>
      </a>
      <span class="site-footer-kicker">Open benchmark · source-first</span>
      <p class="site-footer-tagline">
        The reproducible benchmark for hybrid search engines. Apache-2.0.
      </p>
      <div class="site-footer-meta">
        <span>v0.1.0</span>
        <span class="dot-sep">·</span>
        <span>Python 3.12+</span>
        <span class="dot-sep">·</span>
        <span>109 tests passing</span>
      </div>
    </div>

    <nav class="site-footer-nav" aria-label="Footer">
      {cols.map((col) => (
        <div class="site-footer-col">
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href} rel="noopener">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="site-footer-bottom">
    <div class="container-page">
      <p>
        Released under the Apache-2.0 license. Built with
        <a href="https://astro.build" rel="noopener">Astro</a>.
        © {year} Sachin.
      </p>
      <p>
        A reproducible hybrid search benchmark for retrieval engineers, ML
        researchers, and OSS maintainers.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgb(var(--c-border-subtle));
    background: rgb(var(--c-surface-sunken) / 0.4);
  }
  .site-footer::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(var(--c-brand-500) / 0.7), rgb(var(--c-accent-500) / 0.7), transparent);
    content: "";
  }
  [data-theme="dark"] .site-footer {
    background: rgb(var(--c-surface-sunken) / 0.5);
  }
  .site-footer-inner {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 3rem;
    padding-block: 4.75rem 4.25rem;
  }
  @media (max-width: 820px) {
    .site-footer-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  .site-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }
  .site-footer-brand .site-brand {
    gap: 0.8rem;
    font-size: 1.35rem;
  }
  .site-footer-brand .site-brand-mark {
    width: 44px;
    height: 44px;
    border-radius: 12px;
  }
  .site-footer-kicker {
    color: rgb(var(--c-brand-600));
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .site-footer-tagline {
    font-size: 0.9375rem;
    color: rgb(var(--c-text-soft));
    line-height: 1.55;
    max-width: 320px;
  }
  .site-footer-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: rgb(var(--c-text-mute));
  }
  .dot-sep {
    color: rgb(var(--c-text-faint));
  }
  .site-footer-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  @media (max-width: 540px) {
    .site-footer-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .site-footer-col h3 {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgb(var(--c-text-mute));
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .site-footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .site-footer-col a {
    font-size: 0.875rem;
    color: rgb(var(--c-text-soft));
    transition: color 0.2s var(--ease-smooth);
  }
  .site-footer-col a:hover {
    color: rgb(var(--c-text));
  }
  .site-footer-bottom {
    border-top: 1px solid rgb(var(--c-border-subtle));
    padding-block: 1.25rem;
  }
  .site-footer-bottom .container-page {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
  }
  .site-footer-bottom p:last-child {
    max-width: 48ch;
    text-align: right;
  }
  @media (max-width: 640px) {
    .site-footer-bottom p:last-child {
      text-align: left;
    }
  }
  .site-footer-bottom p {
    font-size: 0.8125rem;
    color: rgb(var(--c-text-mute));
    margin: 0;
  }
  .site-footer-bottom a {
    color: rgb(var(--c-text-soft));
    text-decoration: underline;
    text-decoration-color: rgb(var(--c-text-faint));
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s var(--ease-smooth);
  }
  .site-footer-bottom a:hover {
    text-decoration-color: currentColor;
  }
</style>
